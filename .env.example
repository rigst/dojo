# Ambiente: development (padrão) ou production.
DJANGO_ENV=development

# Obrigatório em produção. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dojo.exemplo.com

# PostgreSQL em produção. Sem esta variável, o app usa SQLite local.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/dojo

# Em produção a conexão exige SSL por padrão. Postgres na mesma máquina, falando
# por localhost, normalmente sobe sem TLS configurado e a conexão falha; nesse
# caso, desligue aqui.
# DJANGO_DB_SSL_REQUIRE=0

# Onde o `collectstatic` escreve. É o mesmo caminho do `alias` no nginx.
# DJANGO_STATIC_ROOT=/srv/dojo/staticfiles

# ---------------------------------------------------------------------------
# Atrás do nginx
# Duas variáveis valem juntas aqui, e as duas dependem de o nginx mandar os
# cabeçalhos (o deploy/nginx.conf.exemplo manda).
#
# Sem X-Forwarded-Proto o Django vê http, porque o TLS termina no nginx, e
# redireciona para https em laço infinito.
#
# Sem X-Forwarded-For todo request chega como 127.0.0.1: as travas por IP passam
# a contar uma máquina só, e oito senhas erradas de qualquer pessoa fecham a
# entrada para todo mundo.
# ---------------------------------------------------------------------------
# DJANGO_USE_X_FORWARDED_PROTO=1
# A outra é DJANGO_TRUST_X_FORWARDED_FOR, lá na seção "Entrada".

# Cache compartilhado entre os workers. Obrigatório em produção: é nele que
# mora a trava de criação de contas de visitante, e um cache por processo faria
# o limite valer uma vez por worker.
# DOJO_REDIS_CACHE_URL=redis://localhost:6379/0
# Alternativa sem subir Redis (exige `manage.py createcachetable`):
# DOJO_CACHE_NO_BANCO=1

# ---------------------------------------------------------------------------
# Mentoria
# ---------------------------------------------------------------------------
# A chave do provedor do app. É uma só, usada por todas as contas.
ANTHROPIC_API_KEY=

# anthropic (padrão) ou fake. "fake" responde sem tocar a rede, e é o que a
# suíte de testes usa.
DOJO_IA_BACKEND=anthropic
DOJO_IA_MODELO=claude-opus-5
DOJO_IA_MAX_TOKENS=64000

# Teto de gasto por conta no mês, em dólar. 0 desliga a checagem.
# Quem define é quem hospeda o app: a chave acima é uma só, e é a conta dela que
# cada resposta consome.
DOJO_IA_LIMITE_MENSAL_USD=10
# Uma conta pode ter teto próprio, definido no admin do Django; ele vale mais
# que este para aquela pessoa. Serve para o caso pontual de alguém precisar de
# mais sem que o limite suba para todo mundo.

# Teto da conta de visitante, que é anônima e qualquer um cria com um clique.
DOJO_IA_LIMITE_VISITANTE_USD=0.5

# Teto do que o aluno pode colar de uma vez, em tokens.
DOJO_IA_MAX_TOKENS_SUBMISSAO=12000

# ---------------------------------------------------------------------------
# Conta de visitante
# ---------------------------------------------------------------------------
# Depois deste prazo a conta é apagada com tudo o que produziu.
DOJO_VISITANTE_TTL_HORAS=48

# Trava por IP na criação de visitantes, para o app não virar uma torneira
# aberta na cota do provedor.
DOJO_VISITANTE_LIMITE=5
DOJO_VISITANTE_JANELA_SEGUNDOS=900

# ---------------------------------------------------------------------------
# Entrada
# ---------------------------------------------------------------------------
# Tentativas fracassadas por IP antes de a tela de entrada recusar, e o tamanho
# da janela em que elas são contadas. Oito é folgado para quem esqueceu a senha
# e apertado para quem está testando lista.
DOJO_LOGIN_TENTATIVAS=8
DOJO_LOGIN_JANELA_SEGUNDOS=900

# Só ligue atrás de um proxy que sobrescreve o cabeçalho (veja o bloco "Atrás do
# nginx" acima). Sem proxy na frente, confiar no X-Forwarded-For deixa qualquer
# um escolher o próprio identificador e escapar das travas trocando de valor.
DJANGO_TRUST_X_FORWARDED_FOR=0

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
# Vai tudo para stderr, que sob systemd é o journal: `journalctl -u dojo -f`.
DJANGO_LOG_LEVEL=INFO
