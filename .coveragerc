# Sem isto, `pytest --cov` mede tudo que for importado, inclusive as
# dependências do venv, e o relatório que vai para o Sonar fica sem
# significado (media o venv inteiro e dava 30%).
[run]
source = .
branch = True
omit =
    */migrations/*
    */tests.py
    */tests_*.py
    */test_*.py
    */tests/*
    */conftest.py
    */venv/*
    */.venv/*
    */node_modules/*
    manage.py
    */wsgi.py
    */asgi.py
    */celery.py
    testes_navegador/*
    scripts/*
    staticfiles/*

[report]
skip_empty = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
