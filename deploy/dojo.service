# /etc/systemd/system/dojo.service
#
# Esta é a unidade que roda em produção. Foi trazida para o repositório em
# 12/09/2026, quando uma auditoria achou a cópia versionada descrevendo uma
# instalação que não existe mais: /srv/dojo, `User=dojo`, venv em `.venv`. O
# app migrou para /var/www/dojo com `User=rod`, padrão dos outros apps deste
# servidor, e o arquivo daqui ficou para trás — quem o usasse para recriar o
# serviço produziria algo que não sobe.
#
# O gunicorn escuta num socket unix que só o nginx enxerga.
#
# O ambiente vem do próprio .env do app, lido pelo settings, e não por
# EnvironmentFile: o formato do systemd não aceita valor com espaço sem aspas,
# e o .env tem pelo menos um (DJANGO_DEFAULT_FROM_EMAIL). Duas cópias da mesma
# configuração, divergindo em silêncio, é pior que uma — que é exatamente o
# defeito que este commit corrige noutro lugar.

[Unit]
Description=Dojo (gunicorn + uvicorn worker)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=notify
User=rod
Group=www-data
WorkingDirectory=/var/www/dojo
Environment=DJANGO_ENV=production
Environment=PYTHONUNBUFFERED=1

# UvicornWorker, e não o worker sync padrão: o chat, o plano e a revisão são
# servidos por SSE, e em WSGI cada conversa aberta prenderia um worker inteiro
# até a resposta terminar.
#
# O timeout é alto porque a conexão fica legitimamente parada enquanto o modelo
# pensa. Quem prova que ela está viva é o batimento de core/sse.py.
#
# Sem `--config`: o gunicorn lê `./gunicorn.conf.py` a partir do
# WorkingDirectory por descoberta. É de lá que vem o `control_socket`, que
# precisa ficar fora de /home por causa do ProtectHome logo abaixo.
ExecStart=/var/www/dojo/venv/bin/gunicorn config.asgi:application \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind unix:/run/dojo/dojo.sock \
    --workers 3 \
    --timeout 300 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -

ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Cria /run/dojo com dono rod:www-data a cada boot e apaga na parada. Sem isso
# o socket precisaria morar num diretório criado à mão, que some no reboot.
RuntimeDirectory=dojo
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
