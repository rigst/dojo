# /etc/systemd/system/dojo-limpar-visitantes.service
#
# Apaga as contas de visitante vencidas com tudo o que produziram. A limpeza
# também roda de carona quando alguém entra como visitante; este timer é a rede
# de segurança para quando ninguém entra por um tempo.
#
# Caminhos e usuário conferidos contra a unidade instalada em 12/09/2026.

[Unit]
Description=Dojo: apaga contas de visitante vencidas

[Service]
Type=oneshot
User=rod
Group=www-data
WorkingDirectory=/var/www/dojo
Environment=DJANGO_ENV=production
ExecStart=/var/www/dojo/venv/bin/python manage.py limpar_visitantes
